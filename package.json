{
  "name": "download-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "hakan4vg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakan4vg/handover.git"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --mode mock",
    "dev:native": "node node_modules/vite/bin/vite.js --mode native",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "build:all": "npm run build && npm run build:extension",
    "package:portable": "node scripts/package-portable.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "build:extension": "node node_modules/vite/bin/vite.js build --config extension/vite.config.ts",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.310",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/chrome": "^0.0.327",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
